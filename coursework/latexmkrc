# latexmk configuration for Fun-Walk coursework
$pdf_mode = 5;          # xelatex
$out_dir = 'build';
$bibtex_use = 2;         # biber
$interaction = 'nonstopmode';
$recorder = 1;

# Ensure build directory exists
ensure_path('build');

# XeLaTeX with shell-escape for some packages
$xelatex = 'xelatex -synctex=1 -interaction=nonstopmode -file-line-error %O %S';
